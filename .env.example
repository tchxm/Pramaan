# Copy this file to .env (repo root) and fill in real values.
# .env is already gitignored — it will never be committed or pushed.

# Primary LLM provider (Anthropic). The spec names this LLM_API_KEY;
# ANTHROPIC_API_KEY also works as a fallback name.
LLM_API_KEY=

# Free-tier fallback (Google Gemini, no credit card required). Get a key at
# https://aistudio.google.com/apikey. Used automatically if Anthropic is
# unconfigured or fails (auth/rate-limit/5xx/timeout).
GEMINI_API_KEY=

# Second fallback (Groq, also free tier). Used automatically if both
# Anthropic and Gemini are unconfigured or fail.
GROQ_API_KEY=

# Optional: override the model id for whichever provider is actually used.
# Anthropic default: claude-sonnet-4-5-20250929
# Groq default: llama-3.3-70b-versatile
# PRAMAAN_MODEL=

# Optional overrides — see PRAMAAN_MASTER_SPEC.md Section 6.1 for the full list.
# PRAMAAN_RUNTIME=on
# PORT=8787

OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

PRAMAAN_LLM_PROVIDERS=openrouter,cloudflare
PRAMAAN_AGENT_MODE=live
PRAMAAN_OPENROUTER_MODEL=openrouter/free
PRAMAAN_CLOUDFLARE_MODEL=